# Chrome Web Store Publishing Configuration
# Copy this file to .env and fill in your actual credentials

# Your extension ID from Chrome Web Store Developer Dashboard
# You'll get this after your first manual submission
EXTENSION_ID=your-extension-id-here

# OAuth2 Client Credentials from Google Cloud Console
# Get these from: https://console.cloud.google.com/
# Go to: APIs & Services > Credentials > Create Credentials > OAuth client ID
# Application type: Chrome Extension
CLIENT_ID=your-client-id-here.apps.googleusercontent.com
CLIENT_SECRET=your-client-secret-here
REFRESH_TOKEN=your-refresh-token-here
